{
  "schemaVersion": 2,
  "platforms": {
    "doubao": {
      "url": "https://www.doubao.com/chat/",
      "input": [
        "textarea[data-testid='chat_input_input']",
        "textarea[placeholder*='输入消息']",
        "textarea[placeholder*='message']",
        "textarea"
      ],
      "sendButton": [
        "#flow-end-msg-send",
        "button[data-testid*='send']",
        "button[aria-label*='发送']",
        "button[aria-label*='Send']"
      ],
      "assistantMessage": [
        "[data-testid='message_text_content']",
        ".message-bubble .markdown-body",
        "[data-testid*='assistant'] .markdown-body",
        "[data-role='assistant']"
      ],
      "loading": [
        "[aria-busy='true']",
        ".loading-spinner",
        "button[aria-label*='停止']",
        "button[aria-label*='Stop']"
      ]
    },
    "yuanbao": {
      "url": "https://yuanbao.tencent.com/",
      "input": [
        "[data-slate-editor='true']",
        "[data-slate-editor]",
        "[contenteditable='true'][data-slate-node]",
        "[role='textbox']",
        "textarea"
      ],
      "sendButton": [
        "button[data-testid*='send']",
        "button[aria-label*='发送']",
        "button[aria-label*='Send']",
        "button[class*='send']",
        "button[type='submit']"
      ],
      "assistantMessage": [
        "[data-role='assistant']",
        "[data-testid*='assistant']",
        ".agent-chat__conv--ai .hyc-content-text",
        ".agent-chat__conv--ai [class*='markdown']",
        ".chat-message[class*='assistant']"
      ],
      "loading": [
        "[data-testid*='loading']",
        "[aria-busy='true']",
        "[class*='loading']",
        "button[aria-label*='停止']"
      ]
    },
    "tongyi": {
      "url": "https://tongyi.aliyun.com/qianwen/",
      "input": [
        "textarea",
        "[contenteditable='true']",
        "[role='textbox']",
        ".ProseMirror"
      ],
      "sendButton": [
        "button[aria-label*='发送']",
        "button[aria-label*='Send']",
        "button[class*='send']",
        "button[data-testid*='send']",
        "button[type='submit']"
      ],
      "assistantMessage": [
        "[data-role='assistant']",
        "[data-message-author-role='assistant']",
        ".qwen-markdown",
        ".tongyi-markdown",
        "[class*='assistant'] [class*='markdown']"
      ],
      "loading": [
        "[aria-busy='true']",
        "[class*='loading']",
        "button[aria-label*='停止']",
        "button[aria-label*='Stop']"
      ]
    },
    "deepseek": {
      "url": "https://chat.deepseek.com/",
      "input": [
        "textarea",
        "[contenteditable='true']",
        "[role='textbox']"
      ],
      "sendButton": [
        "button[aria-label*='发送']",
        "button[aria-label*='Send']",
        "button[data-testid*='send']",
        "button[class*='send']",
        "button[type='submit']"
      ],
      "assistantMessage": [
        "[data-message-author-role='assistant']",
        "[data-role='assistant']",
        ".ds-markdown",
        "[class*='assistant'] .ds-markdown",
        "[class*='assistant'] [class*='markdown']"
      ],
      "loading": [
        "[aria-busy='true']",
        "button[aria-label*='停止']",
        "button[aria-label*='Stop']",
        "[class*='loading']"
      ]
    },
    "kimi": {
      "url": "https://kimi.moonshot.cn/",
      "input": [
        "textarea",
        "[contenteditable='true']",
        "[role='textbox']",
        ".ProseMirror"
      ],
      "sendButton": [
        "button[aria-label*='发送']",
        "button[aria-label*='Send']",
        "button[data-testid*='send']",
        "button[class*='send']",
        "button[type='submit']"
      ],
      "assistantMessage": [
        "[data-role='assistant']",
        "[data-message-author-role='assistant']",
        ".segment-assistant [class*='markdown']",
        ".segment-assistant",
        "[class*='assistant'] [class*='markdown']"
      ],
      "loading": [
        "[aria-busy='true']",
        "[class*='loading']",
        "button[aria-label*='停止']",
        "button[aria-label*='Stop']"
      ]
    }
  }
}
